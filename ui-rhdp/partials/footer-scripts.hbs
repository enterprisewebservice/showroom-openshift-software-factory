{{!-- Progress beacon: tells the hub which guide page is open (view), that it is
     still open (beat, every minute while the tab is visible) and when it is left.
     Same-origin, behind the seat's own sign-in; the seat's router forwards it. --}}
<script>
(function () {
  if (!navigator.sendBeacon) return;
  var page = location.pathname, title = document.title;
  function send(ev) { try { navigator.sendBeacon('/api/progress', JSON.stringify({ ev: ev, path: page, title: title })); } catch (e) {} }
  send('view');
  setInterval(function () { if (document.visibilityState === 'visible') send('beat'); }, 60000);
  document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') send('leave'); });
  window.addEventListener('pagehide', function () { send('leave'); });
})();
</script>
