<header class="header hom-header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item hom-wordmark" href="{{{or site.url (or siteRootUrl siteRootPath)}}}">HANDS-ON&nbsp;<span class="hom-accent">MODE</span></a>
      <span class="navbar-item hom-tagline">Watch it. Run it.</span>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        {{#if page.attributes.links}}
        <div class="navbar-item navbar-item-right-dropdown has-dropdown is-hoverable">
          <a class="navbar-link" href="#">Links</a>
          <div class="navbar-dropdown navbar-dropdown-right">
            {{#each page.attributes.links}}
            <a class="navbar-item navbar-item-right-content" href="{{this.url}}" target="_blank">{{this.text}}</a>
            {{/each}}
          </div>
        </div>
        {{/if}}
        {{#if page.attributes.user}}
        <div class="navbar-item">Seat: {{page.attributes.user}}</div>
        {{/if}}
        <a class="navbar-item hom-cta" href="{{{siteRootPath}}}/modules/handsonmode-start.html#get-a-seat">Get a seat</a>
      </div>
    </div>
  </nav>
</header>
